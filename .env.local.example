# ================================ DEVELOPMENT ENVIRONMENT ===========================================================
# This file is a template for local development variables
# Copy this file to .env.local and fill in your actual values
# Priority: .env.local overrides .env (your local file takes precedence)
# ========================================================================================================

# Self-hosting features (set to true to enable encryption for integrations like Kraken)
SELF_HOSTED=true

# Active Record Encryption Keys (Required for sensitive data encryption)
# Generate with: bin/rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=your_primary_key_here
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=your_deterministic_key_here
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=your_salt_here

# Tink Configuration - EU Banking Integration
# Get credentials from: https://console.tink.com/
# TINK_CLIENT_ID=your_tink_client_id_here
# TINK_CLIENT_SECRET=your_tink_client_secret_here
# TINK_ENV=sandbox
# TINK_BASE_URL=https://api.tink.se
# TINK_REDIRECT_URI=http://localhost:3001/tink/callback

# Enable Synth market data (careful, this will use your API credits)
# Get it here: https://synthfinance.com/
SYNTH_API_KEY=yourapikeyhere

# Optional: Kraken API Configuration for development
# KRAKEN_API_URL=https://api.kraken.com
