<%# locals: (tink_item:) %>

<%= tag.div id: dom_id(tink_item) do %>
  <details open class="group bg-container p-4 shadow-border-xs rounded-xl">
    <summary class="flex items-center justify-between gap-2 focus-visible:outline-hidden">
      <div class="flex items-center gap-2">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>

        <div class="flex items-center justify-center h-8 w-8 bg-green-600/10 rounded-full">
          <% if tink_item.logo.attached? %>
            <%= image_tag tink_item.logo, class: "rounded-full h-full w-full", loading: "lazy" %>
          <% else %>
            <div class="flex items-center justify-center">
              <%= tag.p tink_item.name.first.upcase, class: "text-green-600 text-xs font-medium" %>
            </div>
          <% end %>
        </div>

        <div class="pl-1 text-sm">
          <div class="flex items-center gap-2">
            <%= tag.p tink_item.name, class: "font-medium text-primary" %>
            <% if tink_item.scheduled_for_deletion? %>
              <p class="text-destructive text-sm animate-pulse">(deletion in progress...)</p>
            <% end %>
          </div>
          <% if tink_item.syncing? %>
            <div class="text-secondary flex items-center gap-1">
              <%= icon "loader", size: "sm", class: "animate-pulse" %>
              <%= tag.span "Syncing..." %>
            </div>
          <% elsif tink_item.needs_update? %>
            <div class="text-warning flex items-center gap-1">
              <%= icon "alert-triangle", size: "sm", color: "warning" %>
              <%= tag.span "Requires update" %>
            </div>
          <% elsif tink_item.sync_error.present? %>
            <div class="text-secondary flex items-center gap-1">
              <%= icon "alert-circle", size: "sm", color: "destructive" %>
              <%= tag.span "Error", class: "text-destructive" %>
            </div>
          <% else %>
            <p class="text-secondary">
              <%= tink_item.last_synced_at ? "Synced #{time_ago_in_words(tink_item.last_synced_at)} ago" : "Never synced" %>
            </p>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <% if tink_item.needs_update? %>
          <%= render DS::Link.new(
            text: "Update",
            icon: "refresh-cw",
            variant: "secondary",
            href: edit_tink_item_path(tink_item),
            frame: "modal"
          ) %>
        <% elsif Rails.env.development? %>
          <%= icon(
            "refresh-cw",
            as_button: true,
            href: sync_tink_item_path(tink_item)
          ) %>
        <% end %>

        <%= render DS::Menu.new do |menu| %>
          <% menu.with_item(
            variant: "button",
            text: "Delete",
            icon: "trash-2",
            href: tink_item_path(tink_item),
            method: :delete,
            confirm: CustomConfirm.for_resource_deletion(tink_item.name, high_severity: true)
          ) %>
        <% end %>
      </div>
    </summary>

    <% unless tink_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if tink_item.accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: tink_item.accounts %>
        <% else %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">No accounts found</p>
            <p class="text-secondary text-sm">This Tink connection doesn't have any accounts associated with it.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </details>
<% end %>