<%# Using Maybe Finance DS::Dialog component for proper theming %>
<%= render DS::Dialog.new(variant: "modal", width: "sm", frame: "modal") do |dialog| %>
  <% dialog.with_header(title: "Tink Integration") %>
  
  <% dialog.with_body do %>
    <div class="text-center space-y-4">
      <div class="text-6xl">🐸</div>
      <div class="space-y-2">
        <p class="text-primary">European banking integration is currently being developed. Come back soon for connecting your EU bank accounts!</p>
        <p class="text-sm text-secondary">Ribbit! 🇪🇺</p>
      </div>
    </div>
  <% end %>
  
  <% dialog.with_action(cancel_action: true, text: "Got it!", variant: "outline") %>
<% end %>